generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== TENANT ====================
model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  logoUrl       String?  @map("logo_url")
  language      String   @default("fr")
  timezone      String   @default("Europe/Paris")
  phone         String?
  email         String?
  address       String?
  niu           String?
  city          String?
  country       String?
  currencyCode  String   @default("XAF") @map("currency_code")
  plan          String   @default("starter")
  maxUsers      Int      @default(3) @map("max_users")
  maxStorageGb  Float    @default(5) @map("max_storage_gb")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users           User[]
  clients         Client[]
  cases           Case[]
  invoices        Invoice[]
  documents       Document[]
  messages        Message[]
  events          Event[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  tasks           Task[]
  caseNotes       CaseNote[]
  caseAssignments CaseAssignment[]
  caseTags       CaseTag[]
  caseTaggings   CaseTagging[]
  subscription    Subscription?
  payments          Payment[]
  timeEntries       TimeEntry[]
  documentTemplates DocumentTemplate[]
  communications    Communication[]
  reminderLogs     ReminderLog[]
  clientPortals       ClientPortal[]
  portalNotifications  PortalNotification[]
  externalCalendars     ExternalCalendar[]
  currencies           Currency[]

  @@map("tenants")
}

// ==================== USER ====================
model User {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String?   @map("tenant_id") @db.Uuid
  roleId               String?   @map("role_id") @db.Uuid
  role                 String    @default("lawyer")
  fullName             String    @map("full_name")
  email                String    @unique
  preferredLanguage    String    @default("fr") @map("preferred_language")
  isActive             Boolean   @default(true) @map("is_active")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  lastLoginAt          DateTime? @map("last_login_at")
  lastSessionId        String?   @map("last_session_id")
  sessionCountToday    Int       @default(0) @map("session_count_today")
  avatarUrl            String?   @map("avatar_url")
  phone                String?
  password             String?
  mfaEnabled           Boolean   @default(false) @map("mfa_enabled")
  mfaSecret            String?   @map("mfa_secret")
  forceLogoutAt        DateTime? @map("force_logout_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant               Tenant?   @relation(fields: [tenantId], references: [id])
  roleObj              Role?     @relation(fields: [roleId], references: [id])
  assignedCases        CaseAssignment[]
  assignedEvents       EventAssignment[]
  sentMessages         Message[]  @relation("SentMessages")
  receivedMessages     Message[]  @relation("ReceivedMessages")
  auditLogs            AuditLog[]
  caseNotes            CaseNote[]
  receivedNotifications Notification[] @relation("UserNotifications")
  recordedPayments     Payment[]
  timeEntries          TimeEntry[]
  sentCommunications   Communication[] @relation("SentCommunications")
  uploadedDocuments     Document[]      @relation("DocumentUploader")
  uploadedVersions      DocumentVersion[] @relation("VersionUploader")
  sentReminders         ReminderLog[]  @relation("ReminderSender")
  assignedTasks         Task[]     @relation("TaskAssignee")
  externalCalendars     ExternalCalendar[]

  @@map("users")
}

// ==================== ROLE ====================
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  label       String
  description String?
  level       Int      @default(0)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// ==================== PERMISSION ====================
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// ==================== ROLE PERMISSION ====================
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String   @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== SUBSCRIPTION PLAN ====================
model SubscriptionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  description     String?
  priceAnnual     Float    @default(0) @map("price_annual")
  priceSemiAnnual Float    @default(0) @map("price_semi_annual")
  priceQuarterly  Float    @default(0) @map("price_quarterly")
  priceMonthly    Float    @default(0) @map("price_monthly")
  currencyCode    String   @default("XAF") @map("currency_code")
  maxUsers        Int      @default(3) @map("max_users")
  maxStorageGb    Float    @default(5) @map("max_storage_gb")
  maxCases        Int      @default(50) @map("max_cases")
  hasAI           Boolean  @default(false) @map("has_ai")
  features        String   @default("[]")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscriptions   Subscription[]

  @@map("subscription_plans")
}

// ==================== SUBSCRIPTION ====================
model Subscription {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @unique @map("tenant_id") @db.Uuid
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  planId              String    @map("plan_id") @db.Uuid
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  status              String    @default("active")
  billingPeriod       String    @default("annual") @map("billing_period")
  currentPeriodStart  DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd    DateTime  @map("current_period_end")
  trialEndsAt         DateTime? @map("trial_ends_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

// ==================== CLIENT ====================
model Client {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  fullName            String    @map("full_name")
  company             String?
  phone               String?
  email               String?
  address             String?
  city                String?
  country             String?
  niu                 String?
  notes               String?
  riskLevel           String    @default("faible") @map("risk_level")
  source              String?
  clientType          String?   @map("client_type")
  status              String    @default("active")
  isActive            Boolean   @default(true) @map("is_active")
  responsibleLawyerId String?   @map("responsible_lawyer_id") @db.Uuid
  lastActivityAt      DateTime? @map("last_activity_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  cases               Case[]
  invoices            Invoice[]
  communications      Communication[]
  portalAccounts      ClientPortal[]

  @@map("clients")
}

// ==================== CASE ====================
model Case {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  caseType        String    @default("civil") @map("case_type")
  status          String    @default("nouveau")
  outcome         String?
  paymentStatus   String?   @map("payment_status")
  priority        String    @default("normal")
  isSecret        Boolean   @default(false) @map("is_secret")
  reference       String?
  adversary       String?
  jurisdiction    String?
  amountInDispute Float?    @map("amount_in_dispute")
  billingType     String?   @map("billing_type")
  nextDueDate     DateTime? @map("next_due_date")
  aiAnalysis      String?   @map("ai_analysis")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  clientId        String   @map("client_id") @db.Uuid
  client          Client   @relation(fields: [clientId], references: [id])

  assignments     CaseAssignment[]
  taggings        CaseTagging[]
  documents       Document[]
  events          Event[]
  invoices        Invoice[]
  notes           CaseNote[]
  tasks           Task[]
  timeEntries      TimeEntry[]
  communications   Communication[]

  @@map("cases")
}

model CaseAssignment {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  caseId   String @map("case_id") @db.Uuid
  case     Case   @relation(fields: [caseId], references: [id])
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, caseId])
  @@map("case_assignments")
}

model CaseNote {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  caseId   String   @map("case_id") @db.Uuid
  case     Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId String?  @map("author_id") @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id])
  tenantId String   @map("tenant_id") @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  @@index([caseId])
  @@map("case_notes")
}

// ==================== DOCUMENT ====================
model Document {
  id          String  @id @default(uuid()) @db.Uuid
  fileName    String  @map("file_name")
  fileSize    Int     @map("file_size")
  filePath    String  @map("file_path")
  version     Int     @default(1)
  folder      String?
  tags        String?
  documentType String? @map("document_type")
  mimeType    String? @map("mime_type")
  description String?
  status      String  @default("actif")
  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploadedBy  User?   @relation("DocumentUploader", fields: [uploadedById], references: [id])
  uploadedByPortalId String? @map("uploaded_by_portal_id") @db.Uuid
  uploadedByPortal ClientPortal? @relation("PortalDocumentUpload", fields: [uploadedByPortalId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantId    String  @map("tenant_id") @db.Uuid
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  caseId      String? @map("case_id") @db.Uuid
  case        Case?   @relation(fields: [caseId], references: [id])

  versions    DocumentVersion[]

  @@map("documents")
}

// ==================== DOCUMENT VERSION ====================
model DocumentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     Int
  fileName    String   @map("file_name")
  fileSize    Int      @map("file_size")
  filePath    String   @map("file_path")
  mimeType    String?  @map("mime_type")
  changeNote  String?  @map("change_note")
  createdAt   DateTime @default(now()) @map("created_at")

  documentId  String   @map("document_id") @db.Uuid
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploadedBy  User?    @relation("VersionUploader", fields: [uploadedById], references: [id])

  @@map("document_versions")
}

// ==================== EVENT ====================
model Event {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  eventType   String    @default("audience") @map("event_type")
  criticality String    @default("normal")
  location        String?
  externalEventId String? @map("external_event_id")
  allDay          Boolean @default(false) @map("all_day")
  createdAt   DateTime @default(now()) @map("created_at")

  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  caseId      String?   @map("case_id") @db.Uuid
  case        Case?     @relation(fields: [caseId], references: [id])

  assignments   EventAssignment[]
  notifications Notification[]
  tasks         Task[]

  @@map("events")
}

model EventAssignment {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id])
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("event_assignments")
}

// ==================== INVOICE ====================
model Invoice {
  id            String    @id @default(uuid()) @db.Uuid
  invoiceNumber String?   @map("invoice_number")
  type          String    @default("facture") // devis, facture, avoir, recu
  amount        Float
  paidAmount    Float    @default(0) @map("paid_amount")
  status        String    @default("non_paye") // non_paye, partiel, paye, annule
  issuedAt      DateTime? @map("issued_at")
  dueDate       DateTime? @map("due_date")
  notes         String?
  billingType   String?   @map("billing_type")
  reminderLevel Int      @default(0) @map("reminder_level") // 0=none, 1=1re relance, 2=2e, 3=3e, 4=mise en demeure
  lastReminderAt DateTime? @map("last_reminder_at")
  taxRate       Float    @default(0) @map("tax_rate")
  discountAmount Float   @default(0) @map("discount_amount")
  terms         String?
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  clientId      String    @map("client_id") @db.Uuid
  client        Client    @relation(fields: [clientId], references: [id])
  caseId        String?   @map("case_id") @db.Uuid
  case          Case?     @relation(fields: [caseId], references: [id])
  currencyId    String?   @map("currency_id") @db.Uuid
  currency      Currency? @relation(fields: [currencyId], references: [id])

  lineItems     InvoiceLineItem[]
  payments      Payment[]
  reminders     ReminderLog[]
  timeEntries   TimeEntry[]

  @@map("invoices")
}

// ==================== INVOICE LINE ITEM ====================
model InvoiceLineItem {
  id          String  @id @default(uuid()) @db.Uuid
  description String
  quantity    Int     @default(1)
  unitPrice   Float   @map("unit_price")
  total       Float
  sortOrder   Int     @default(0) @map("sort_order")

  invoiceId   String  @map("invoice_id") @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

// ==================== PAYMENT ====================
model Payment {
  id            String    @id @default(uuid()) @db.Uuid
  amount        Float
  method        String    @default("virement") // especes, virement, mobile_money, carte, cheque
  reference     String?
  status        String    @default("complet") // complet, partiel, annule
  paidAt        DateTime  @default(now()) @map("paid_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  invoiceId     String    @map("invoice_id") @db.Uuid
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy    String?   @map("recorded_by") @db.Uuid
  recorder      User?     @relation(fields: [recordedBy], references: [id])

  @@map("payments")
}

// ==================== MESSAGE ====================
model Message {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  tenantId  String   @map("tenant_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String   @map("receiver_id") @db.Uuid
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("messages")
}

// ==================== NOTIFICATION ====================
model Notification {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  message      String
  category     String   @default("dossier")
  read         Boolean  @default(false)
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation("UserNotifications", fields: [userId], references: [id])
  eventId      String?  @map("event_id") @db.Uuid
  event        Event?   @relation(fields: [eventId], references: [id])

  @@map("notifications")
}

// ==================== TASK ====================
model Task {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      String    @default("a_faire")
  priority    String    @default("normal")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  caseId       String?   @map("case_id") @db.Uuid
  case         Case?     @relation(fields: [caseId], references: [id])
  eventId      String?   @map("event_id") @db.Uuid
  event        Event?    @relation(fields: [eventId], references: [id])
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  assignedTo   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([status])
  @@index([assignedToId])
  @@map("tasks")
}

// ==================== AUDIT LOG ====================
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  metadata     String?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  timestamp    DateTime @default(now())

  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ==================== TIME ENTRY ====================
model TimeEntry {
  id          String    @id @default(uuid()) @db.Uuid
  description String
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  duration    Int       @default(0) // in seconds
  isBillable  Boolean   @default(true) @map("is_billable")
  hourlyRate  Float?    @map("hourly_rate")
  totalAmount Float?
  billed      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  caseId   String? @map("case_id") @db.Uuid
  case     Case?  @relation(fields: [caseId], references: [id])
  invoiceId String? @map("invoice_id") @db.Uuid
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, userId])
  @@index([caseId])
  @@map("time_entries")
}

// ==================== DOCUMENT TEMPLATE ====================
model DocumentTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  category    String   @default("general")
  description String?
  content     String
  variables   String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("document_templates")
}

// ==================== COMMUNICATION ====================
model Communication {
  id             String    @id @default(uuid()) @db.Uuid
  type           String    @default("email")
  subject        String?
  content        String
  status         String    @default("pending")
  recipientEmail String?   @map("recipient_email")
  recipientPhone String?   @map("recipient_phone")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenantId  String  @map("tenant_id") @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  caseId    String? @map("case_id") @db.Uuid
  case      Case?  @relation(fields: [caseId], references: [id])
  clientId  String? @map("client_id") @db.Uuid
  client    Client? @relation(fields: [clientId], references: [id])
  sentById  String? @map("sent_by_id") @db.Uuid
  sentBy    User?   @relation("SentCommunications", fields: [sentById], references: [id])

  @@index([tenantId, type])
  @@index([caseId])
  @@map("communications")
}

// ==================== REMINDER LOG ====================
model ReminderLog {
  id          String   @id @default(uuid()) @db.Uuid
  level       Int      // 1=1re relance, 2=2e, 3=3e, 4=mise en demeure
  method      String   @default("email") // email, sms, whatsapp
  subject     String?
  content     String
  status      String   @default("sent") // sent, failed, pending
  sentAt      DateTime @default(now()) @map("sent_at")
  daysOverdue Int      @map("days_overdue")
  amountDue   Float    @map("amount_due")

  invoiceId   String   @map("invoice_id") @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  sentById    String?  @map("sent_by_id") @db.Uuid
  sentBy      User?    @relation("ReminderSender", fields: [sentById], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
  @@map("reminder_logs")
}

// ==================== CLIENT PORTAL ====================
model ClientPortal {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  resetToken    String?   @unique @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  clientId String @map("client_id") @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  portalNotifications PortalNotification[]
  documents           Document[] @relation("PortalDocumentUpload")

  @@map("client_portals")
}

// ==================== PORTAL NOTIFICATION ====================
model PortalNotification {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  message      String
  category     String   @default("dossier")
  read         Boolean  @default(false)
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  portalId String @map("portal_id") @db.Uuid
  portal   ClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([portalId])
  @@index([tenantId])
  @@map("portal_notifications")
}

// ==================== EXTERNAL CALENDAR ====================
model ExternalCalendar {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String // google, outlook
  accessToken    String    @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiry    DateTime? @map("token_expiry")
  calendarId     String?   @map("calendar_id")
  calendarEmail  String?   @map("calendar_email")
  syncEnabled    Boolean   @default(true) @map("sync_enabled")
  lastSyncAt     DateTime? @map("last_sync_at")
  syncDirection  String    @default("bidirectional") @map("sync_direction") // oneway_out, oneway_in, bidirectional
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId, provider])
  @@map("external_calendars")
}

// ==================== CASE TAG ====================
model CaseTag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  color     String   @default("#6B7280")
  createdAt DateTime @default(now()) @map("created_at")

  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taggings  CaseTagging[]

  @@unique([name, tenantId])
  @@map("case_tags")
}

model CaseTagging {
  caseId   String   @map("case_id") @db.Uuid
  tagId    String   @map("tag_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tag      CaseTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([caseId, tagId])
  @@map("case_taggings")
}

// ==================== CURRENCY ====================
model Currency {
  id        String    @id @default(uuid()) @db.Uuid
  code      String
  name      String
  symbol    String
  tenantId  String?   @map("tenant_id") @db.Uuid
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  invoices  Invoice[]

  @@unique([code, tenantId])
  @@map("currencies")
}
